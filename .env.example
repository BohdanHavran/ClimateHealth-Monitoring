# Copy to .env for local use. No real credentials belong in this file.
# Existing MySQL; do not start a duplicate database for normal development.
DB_HOST=192.168.0.165
DB_USER=climate_app
DB_NAME=climate_db
DB_PASSWORD_FILE=./.secrets/db_password
DB_PASS_FILE=.secrets/db_password
OPENWEATHER_API_KEY=
PORT=8000
FLASK_DEBUG=false
# Local ML only; a shared random token must be provided through protected local config.
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TOKEN=
